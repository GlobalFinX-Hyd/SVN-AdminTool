{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Warning"
      }
    }
  },
  "AllowedHosts": "svnadmin.example.com;localhost;127.0.0.1",
  "Urls": "http://127.0.0.1:5080",
  "Svn": {
    "ProductName": "SVN Admin",
    "LogoFile": "",
    "DatabasePath": "C:/SvnAdmin/data/svnadmin.db",
    "PasswdFile": "C:/Subversion/svn_users.passwd",
    "AuthzFile": "C:/Subversion/svn_access_control.authz",
    "RepositoriesRoot": "C:/Subversion/Repositories",
    "ArchiveRoot": "C:/Subversion/Archive",
    "BackupRoot": "C:/SvnAdmin/backups",
    "ConfigHistoryDir": "C:/Subversion/config-history",
    "ConfigHistoryKeep": 200,
    "SvnBinDir": "",
    "AdminGroup": "itadmins",
    "PublicUrl": "https://svn.example.com",
    "MinPasswordLength": 10,
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15,
    "SessionIdleMinutes": 30,
    "PasswordMaxAgeDays": 365,
    "AppUrl": "https://svnadmin.example.com",
    "RequireAdminMfa": true,
    "WelcomeLinkHours": 72,
    "ResetLinkMinutes": 60,
    "DormantDays": 180,
    "Passkeys": {
      "RelyingPartyId": "svnadmin.example.com",
      "RelyingPartyName": "",
      "Origins": [ "https://svnadmin.example.com" ]
    }
  },
  "Email": {
    "Enabled": false,
    "Host": "",
    "Port": 587,
    "Username": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "SVN Admin"
  }
}

    "@angular/router": "^21.0.0",
    "@fontsource/inter": "^5.2.8",
    "material-symbols": "^0.31.9",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.4",
    "@angular/cli": "^21.0.4",
